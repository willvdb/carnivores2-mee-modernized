---
# ── Carnivores 2 (MEE 1.11) ──────────────────────────────────────────────────
# Legacy game-port codebase with modernisation in progress (smart pointers,
# namespaces, STL containers). Still has Windows API, raw pointers in
# legacy paths, and game-constant magic numbers — the checks below reflect
# that reality while gently pushing toward safer C++.
# ──────────────────────────────────────────────────────────────────────────────

Checks: |
  # ── Bug-prone patterns (actual bugs) ──
  bugprone-*,

  # ── Performance ──
  performance-*,

  # ── Safer modernisation ──
  modernize-*,
  -modernize-use-trailing-return-type,   # style preference, noisy
  -modernize-avoid-c-arrays,             # Windows API requires C arrays

  # ── Readability ──
  readability-*,
  -readability-magic-numbers,            # game constants
  -readability-avoid-const-params-in-decls,

  # ── General-purpose ──
  misc-*,
  -misc-misplaced-const,
  -misc-no-recursion,

  # ── Static analysis ──
  clang-analyzer-*,

  # ── C++ Core Guidelines (game-code-aware subset) ──
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-cstyle-cast,

CheckOptions:
  - { key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions, value: 1 }
  - { key: cppcoreguidelines-special-member-functions.AllowMissingMoveConstructors, value: 1 }
  - { key: readability-magic-numbers.IgnoreAllFloatingPointLiteralValues, value: 1 }
  - { key: performance-unnecessary-value-param.CheckTriviallyCopyableParams, value: 1 }

# ── Warnings as errors ───────────────────────────────────────────────────────
# The legacy port has a measured warning baseline. Keep high-confidence lifetime
# and memory checks blocking while the compatibility-heavy checks remain
# advisory until they can be fixed without a broad refactor.
WarningsAsErrors: |
  bugprone-bad-signal,
  bugprone-dangling-handle,
  bugprone-sizeof-expression,
  bugprone-suspicious-memset-usage,
  bugprone-use-after-move

# ── Files to analyse ─────────────────────────────────────────────────────────
HeaderFilterRegex: '.*'
