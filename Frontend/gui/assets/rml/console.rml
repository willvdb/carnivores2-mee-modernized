<rml>
<head>
    <title>Expedition Console</title>
    <link type="text/rcss" href="../rcss/theme.rcss"/>
</head>
<body data-model="console" class="screen">
    <div class="console-root">
        <div class="console-header">
            <button id="console-back" class="btn" data-event-click="back()">Back</button>
            <div class="grow">
                <div class="title">Expedition Console</div>
                <div class="subtitle">{{source_line}}</div>
            </div>
        </div>
        <div class="console-body">
            <div class="list-pane">
                <div class="pane-title">Expeditions ({{expedition_count}})</div>
                <div id="expedition-list" class="list">
                    <div class="state" data-if="state_loading">Loading store...</div>
                    <div class="state error" data-if="state_error">{{load_error}}</div>
                    <div class="state" data-if="state_empty">No expeditions are registered in this store.</div>
                    <div class="state" data-if="state_no_manifest">This directory has no lodge.json; the core observed the empty default manifest. Nothing was created.</div>
                    <div class="row" data-for="e : expeditions" data-attr-id="'exp-' + e.id" data-class-selected="e.selected" data-event-click="select_expedition(e.id)">
                        <div class="row-label">{{e.label}}</div>
                        <div class="row-sub">{{e.mode}} · {{e.flavor}} · …{{e.short_id}}</div>
                    </div>
                </div>
            </div>
            <div class="details-pane">
                <div class="state" data-if="!has_selection">Select an expedition to see its details. Use Up/Down (or the D-pad) in the list and Enter to select; Right moves to this panel.</div>
                <div data-if="has_selection">
                    <div class="detail-title">{{sel_label}}</div>
                    <div id="preview-art" class="preview-art"></div>
                    <div class="kv"><span class="k">Identity</span><span class="v">{{sel_id}}</span></div>
                    <div class="kv"><span class="k">Locator</span><span class="v wrap">{{sel_path}}</span></div>
                    <div class="kv"><span class="k">Mode</span><span class="v">{{sel_mode}} ({{sel_flavor}} path)</span></div>
                    <div class="section-title">Viewing as hunter <span class="badge">local selection, not persisted</span></div>
                    <div>
                        <div class="hunter-row" data-for="h : hunters" data-attr-id="'hunter-' + h.id" data-class-selected="h.selected" data-event-click="view_hunter(h.id)">{{h.name}} …{{h.short_id}}{{h.suffix}}</div>
                        <div class="state" data-if="hunters.size == 0">No hunters in this store.</div>
                    </div>
                </div>
                    <div class="loop-console">
                        <div class="section-title">Hunt preparation</div>
                        <div class="explain">{{source}}</div>
                        <div class="field"><label>Hunter / expedition association</label>
                            <select id="association-select" data-value="association" data-attrif-disabled="busy"></select></div>
                        <div class="field"><label>Area</label><select id="loop-area" data-value="loop_area" data-attrif-disabled="busy"></select></div>
                        <div class="field"><label>License (catalog selection)</label><select id="loop-license" data-value="loop_license" data-attrif-disabled="busy"></select></div>
                        <div class="field"><label>Weapon</label><select id="loop-weapon" data-value="loop_weapon" data-attrif-disabled="busy"></select></div>
                        <div class="field"><label>Time</label><select id="loop-time" data-value="loop_time" data-attrif-disabled="busy">
                            <option value="0">Dawn</option><option value="1">Day</option><option value="2">Night</option></select></div>
                        <div class="actions">
                            <button id="plan-button" class="btn" data-attrif-disabled="!can_plan" data-class-disabled="!can_plan" data-event-click="operate('plan')">Validate loadout</button>
                            <button id="prepare-button" class="btn" data-attrif-disabled="!can_prepare" data-class-disabled="!can_prepare" data-event-click="operate('prepare')">Prepare fresh session</button>
                            <button id="launch-button" class="btn primary" data-attrif-disabled="!can_run" data-class-disabled="!can_run" data-event-click="operate('run')">Run prepared session</button>
                            <button id="cancel-run" class="btn" data-attrif-disabled="!busy" data-class-disabled="!busy" data-event-click="operate('cancel')">Cancel run</button>
                            <button id="review-button" class="btn" data-event-click="operate('review')">Return review</button>
                        </div>
                        <div class="section-title">{{loop_status}}</div>
                        <div class="error wrap">{{loop_error}}</div>
                        <div class="pins">{{pins}}</div>
                        <div data-if="schema_one" class="explain">Schema 1: reading does not upgrade. Explicit upgrade creates lodge.schema-1.backup.json and generation-zero identities; its backend result is shown below.
                            <button id="upgrade-button" class="btn" data-attrif-disabled="!can_upgrade" data-class-disabled="!can_upgrade" data-event-click="operate('upgrade')">Upgrade managed metadata</button></div>
                        <div class="field"><label>Inspect retained session UUID</label><input id="session-id" class="text" type="text" data-value="recovery_id"/></div>
                        <button id="inspect-session" class="btn" data-attrif-disabled="busy" data-class-disabled="busy" data-event-click="operate('load_session')">Inspect retained session</button>
                        <div class="evidence">{{loop_details}}</div>
                    </div>
            </div>
        </div>
    </div>
</body>
</rml>
