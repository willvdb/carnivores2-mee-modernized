{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}"
      }
    },
    {
      "name": "windows-x86-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CARNIVORES_ARCH": "x86"
      }
    },
    {
      "name": "windows-x64-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CARNIVORES_ARCH": "x64"
      }
    },
    {
      "name": "gl-debug-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RENDERER": "GL",
        "MEM_DEBUG": "ON",
        "ENABLE_RENDERER_LOGGING": "ON",
        "ENABLE_TERRAIN_LOGGING": "OFF"
      }
    },
    {
      "name": "gl-release-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RENDERER": "GL",
        "GL_PERF_HOOKS": "ON"
      }
    },
    {
      "name": "soft-debug",
      "displayName": "Windows x86 Software (Debug)",
      "inherits": "windows-x86-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RENDERER": "SOFT",
        "MEM_DEBUG": "ON",
        "ENABLE_RENDERER_LOGGING": "ON",
        "ENABLE_TERRAIN_LOGGING": "OFF"
      }
    },
    {
      "name": "soft-release",
      "displayName": "Windows x86 Software (Release)",
      "inherits": "windows-x86-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RENDERER": "SOFT"
      }
    },
    {
      "name": "ogl-debug",
      "displayName": "OpenGL (Debug)",
      "inherits": [
        "windows-x86-base",
        "gl-debug-base"
      ]
    },
    {
      "name": "ogl-release",
      "displayName": "OpenGL (Release)",
      "inherits": [
        "windows-x86-base",
        "gl-release-base"
      ]
    },
    {
      "name": "ogl-release-shipping",
      "displayName": "OpenGL (Release, Shipping)",
      "inherits": "ogl-release",
      "cacheVariables": {
        "GL_PERF_HOOKS": "OFF"
      }
    },
    {
      "name": "menu-release",
      "displayName": "Menu (Release)",
      "inherits": "windows-x86-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ogl-pgo-instr",
      "displayName": "OpenGL PGO (Instrumented)",
      "inherits": "ogl-release",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELEASE": "/GL /O2 /Ob2 /DNDEBUG /GENPROFILE"
      }
    },
    {
      "name": "ogl-pgo-opt",
      "displayName": "OpenGL PGO (Optimized)",
      "inherits": "ogl-release",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELEASE": "/GL /O2 /Ob2 /DNDEBUG /USEPROFILE"
      }
    },
    {
      "name": "windows-x86-gl-debug",
      "displayName": "Windows x86 OpenGL (Debug)",
      "inherits": [
        "windows-x86-base",
        "gl-debug-base"
      ]
    },
    {
      "name": "windows-x86-gl-release",
      "displayName": "Windows x86 OpenGL (Release)",
      "inherits": [
        "windows-x86-base",
        "gl-release-base"
      ]
    },
    {
      "name": "windows-x64-gl-debug",
      "displayName": "Windows x64 OpenGL (Debug)",
      "inherits": [
        "windows-x64-base",
        "gl-debug-base"
      ]
    },
    {
      "name": "windows-x64-gl-release",
      "displayName": "Windows x64 OpenGL (Release)",
      "inherits": [
        "windows-x64-base",
        "gl-release-base"
      ]
    },
    {
      "name": "windows-x86-sdl-gl-debug",
      "displayName": "Windows x86 SDL3 OpenGL (Debug)",
      "inherits": "windows-x86-gl-debug",
      "cacheVariables": {
        "CARNIVORES_PLATFORM": "SDL3"
      }
    },
    {
      "name": "windows-x86-sdl-gl-release",
      "displayName": "Windows x86 SDL3 OpenGL (Release)",
      "inherits": "windows-x86-gl-release",
      "cacheVariables": {
        "CARNIVORES_PLATFORM": "SDL3"
      }
    },
    {
      "name": "windows-x64-sdl-gl-debug",
      "displayName": "Windows x64 SDL3 OpenGL (Debug)",
      "inherits": "windows-x64-gl-debug",
      "cacheVariables": {
        "CARNIVORES_PLATFORM": "SDL3"
      }
    },
    {
      "name": "windows-x64-sdl-gl-release",
      "displayName": "Windows x64 SDL3 OpenGL (Release)",
      "inherits": "windows-x64-gl-release",
      "cacheVariables": {
        "CARNIVORES_PLATFORM": "SDL3"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "soft-debug",
      "configurePreset": "soft-debug"
    },
    {
      "name": "soft-release",
      "configurePreset": "soft-release"
    },
    {
      "name": "ogl-debug",
      "configurePreset": "ogl-debug"
    },
    {
      "name": "ogl-release",
      "configurePreset": "ogl-release"
    },
    {
      "name": "ogl-release-shipping",
      "configurePreset": "ogl-release-shipping"
    },
    {
      "name": "menu-release",
      "configurePreset": "menu-release"
    },
    {
      "name": "ogl-pgo-instr",
      "configurePreset": "ogl-pgo-instr"
    },
    {
      "name": "ogl-pgo-opt",
      "configurePreset": "ogl-pgo-opt"
    },
    {
      "name": "windows-x86-gl-debug",
      "configurePreset": "windows-x86-gl-debug"
    },
    {
      "name": "windows-x86-gl-release",
      "configurePreset": "windows-x86-gl-release"
    },
    {
      "name": "windows-x64-gl-debug",
      "configurePreset": "windows-x64-gl-debug"
    },
    {
      "name": "windows-x64-gl-release",
      "configurePreset": "windows-x64-gl-release"
    },
    {
      "name": "windows-x86-sdl-gl-debug",
      "configurePreset": "windows-x86-sdl-gl-debug"
    },
    {
      "name": "windows-x86-sdl-gl-release",
      "configurePreset": "windows-x86-sdl-gl-release"
    },
    {
      "name": "windows-x64-sdl-gl-debug",
      "configurePreset": "windows-x64-sdl-gl-debug"
    },
    {
      "name": "windows-x64-sdl-gl-release",
      "configurePreset": "windows-x64-sdl-gl-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x86-gl-debug",
      "configurePreset": "windows-x86-gl-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^Carnivores2Tests"
        }
      }
    },
    {
      "name": "windows-x86-gl-release",
      "configurePreset": "windows-x86-gl-release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^Carnivores2Tests"
        }
      }
    },
    {
      "name": "windows-x64-gl-debug",
      "configurePreset": "windows-x64-gl-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^Carnivores2Tests"
        }
      }
    },
    {
      "name": "windows-x64-gl-release",
      "configurePreset": "windows-x64-gl-release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^Carnivores2Tests"
        }
      }
    },
    {
      "name": "windows-x86-sdl-gl-debug",
      "configurePreset": "windows-x86-sdl-gl-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^Carnivores2Tests"
        }
      }
    },
    {
      "name": "windows-x86-sdl-gl-release",
      "configurePreset": "windows-x86-sdl-gl-release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^Carnivores2Tests"
        }
      }
    },
    {
      "name": "windows-x64-sdl-gl-debug",
      "configurePreset": "windows-x64-sdl-gl-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^Carnivores2Tests"
        }
      }
    },
    {
      "name": "windows-x64-sdl-gl-release",
      "configurePreset": "windows-x64-sdl-gl-release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^Carnivores2Tests"
        }
      }
    }
  ]
}
